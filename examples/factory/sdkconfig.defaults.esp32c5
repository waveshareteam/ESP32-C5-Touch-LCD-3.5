CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SR_WN_WN9S_NIHAOXIAOZHI=y
CONFIG_ESP_VIDEO_ENABLE_SPI_VIDEO_DEVICE=y
CONFIG_CAMERA_BF3901=y
CONFIG_CAMERA_BF3901_AUTO_DETECT_SPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_BF3901_SPI_RGB565_240X320_20FPS=y
CONFIG_CAMERA_BF3901_SPI_DEFAULT_FMT_RGB565_240X320_20FPS=y
# SPI (LCD/SD), I2S and PARLIO camera use all three C5 GDMA channels.
# Use software AES/SHA so network crypto does not retain another DMA pair.
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_SHA=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
